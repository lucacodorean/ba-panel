{
    "name": "lucacodorean/ba-panel",
    "description": "A PHP package intended to create a panel for the Business analysts to access the documentation saved at project level.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Luca Codorean",
            "email": "luca.codorean@evozon.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "league/commonmark": "^2.8",
        "neuron-core/neuron-ai": "^4.1",
        "symfony/yaml": "^7.4|^8.0"
    },
    "require-dev": {
        "illuminate/routing": "^13.5",
        "illuminate/support": "^13.5",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3",
        "symfony/framework-bundle": "^8.1",
        "symfony/security-csrf": "^8.1"
    },
    "suggest": {
        "illuminate/routing": "^13.5 Required by the Laravel shell.",
        "illuminate/support": "^13.5 Required by the Laravel shell.",
        "symfony/framework-bundle": "^8.1 Required by the Symfony shell.",
        "symfony/security-csrf": "^8.1 Enables the CSRF check of the Symfony shell."
    },
    "conflict": {
        "illuminate/support": "<13.5",
        "symfony/framework-bundle": "<8.1"
    },
    "autoload": {
        "psr-4": {
            "Lucacodorean\\BaPanel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lucacodorean\\BaPanel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lucacodorean\\BaPanel\\Laravel\\BaPanelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
